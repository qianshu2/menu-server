/* 全局样式 — 所有页面共用 */
page {
  font-family: sans-serif;
  /* 暖米白背景，呼应小夏的白毛 */
  background: #FBF4EE;
}

/* ===== 统一图片容器：圆角 + 裁切 ===== */
.img-box {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  flex-shrink: 0;
  background: #F1E6DB;
}

/* ===== 骨架屏（加载占位） ===== */
.skeleton {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(100deg, #ece3da 25%, #f6efe8 50%, #ece3da 75%);
  background-size: 200% 100%;
  animation: shimmer 1.2s linear infinite;
}
@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
