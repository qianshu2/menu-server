/* 遮罩层 */
.mask {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 200;
}

/* 底部弹出的卡片 */
.sheet {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 18px 18px 0 0;
  overflow: hidden;
  animation: slideUp 0.28s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

/* 大图 */
.hero-box {
  width: 100%;
  height: 260px;
}
.hero-img {
  width: 100%;
  height: 100%;
  display: block;
  transition: opacity .25s ease;
}

/* 信息区 */
.body {
  padding: 18px 20px 26px;
}

.name {
  font-size: 20px;
  font-weight: bold;
  color: #222;
}

.tag {
  display: inline-block;
  margin-top: 8px;
  padding: 3px 12px;
  background: #FBEDE2;
  color: #F08A4B;
  font-size: 13px;
  border-radius: 14px;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 12px;
  margin-top: 18px;
}

.btn {
  flex: 1;
  height: 44px;
  line-height: 44px;
  border-radius: 22px;
  font-size: 15px;
  font-weight: bold;
  border: none;
}

.btn::after { border: none; }

.btn.primary {
  background: #F08A4B;
  color: #fff;
}

.btn.ghost {
  background: #fff;
  color: #F08A4B;
  border: 1px solid #F08A4B;
}

/* 关闭按钮 */
.close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 32px;
  height: 32px;
  line-height: 30px;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 22px;
}
