<!-- 菜谱详情页 -->
<scroll-view scroll-y class="page">
  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{dish}}" class="detail">
    <view class="img-box dish-hero">
      <view wx:if="{{!imgLoaded && !imgError}}" class="skeleton"></view>
      <image wx:if="{{!imgError}}" class="dish-img" src="{{apiBase}}{{dish.image}}" mode="aspectFill"
             bindload="onImgLoad" binderror="onImgError" style="opacity:{{imgLoaded ? 1 : 0}}" />
      <image wx:else class="dish-img" src="{{placeholder}}" mode="aspectFit" />
    </view>
    <view class="dish-name">{{dish.name}}</view>
    <view class="dish-cat">{{dish.category}}</view>

    <view class="section-title">食材</view>
    <view class="section-body">{{dish.recipe}}</view>

    <view class="section-title">做法</view>
    <view class="steps">
      <view wx:for="{{steps}}" wx:key="index" class="step">{{item}}</view>
    </view>
  </view>

  <view wx:else class="loading">暂无菜谱</view>
</scroll-view>
