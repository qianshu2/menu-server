.page { padding-bottom: 30px; background: #FBF4EE; }
.loading { text-align: center; padding: 50px; color: #b3a89c; font-size: 14px; }

.detail { background: #fff; }
.dish-hero { width: 100%; height: 220px; }
.dish-img { width: 100%; height: 100%; display: block; }
.dish-name { font-size: 20px; font-weight: bold; padding: 14px 16px 2px; color: #3a2f28; }
.dish-cat { font-size: 12px; color: #F08A4B; padding: 0 16px 10px; }

.section-title { font-size: 15px; font-weight: bold; color: #3a2f28; padding: 14px 16px 6px; border-top: 1px solid #f0ece8; }
.section-body { font-size: 14px; color: #6b5f54; line-height: 1.7; padding: 0 16px; }

.steps { padding: 0 16px; }
.step { font-size: 14px; color: #6b5f54; line-height: 1.8; padding: 8px 12px; margin-top: 8px; background: #FBF4EE; border-radius: 8px; border-left: 3px solid #F08A4B; }
