.page { padding-bottom: 30px; background: #FBF4EE; }
.header { background: #F08A4B; color: #fff; padding: 16px; text-align: center; font-size: 18px; font-weight: bold; }

.loading, .empty { text-align: center; padding: 50px 20px; }
.empty-img { width: 150px; height: 188px; margin: 0 auto 12px; display: block; border-radius: 14px; background: #fff; }
.empty-title { font-size: 16px; color: #3a2f28; margin-bottom: 8px; font-weight: bold; }
.empty-sub { font-size: 13px; color: #9C8E80; margin-bottom: 16px; line-height: 1.6; }
.go-btn { display: inline-block; background: #F08A4B; color: #fff; font-size: 14px; border-radius: 20px; padding: 6px 24px; }
.go-btn::after { border: none; }

.progress { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; font-size: 15px; color: #F08A4B; font-weight: bold; }
.progress-btns { display: flex; gap: 8px; }
.mini-btn { background: #f0f0f0; color: #888; font-size: 12px; border-radius: 16px; padding: 0 12px; height: 28px; line-height: 28px; min-height: 0; margin: 0; }
.mini-btn::after { border: none; }
.mini-btn.danger { color: #e74c3c; }
.mini-btn.staple { color: #8e6b1f; background: #fdf3df; }

.tip { font-size: 12px; color: #aaa; padding: 0 16px 10px; }

.group { margin: 8px 16px 4px; background: #fff; border-radius: 10px; overflow: hidden; }
.group-title { font-size: 14px; font-weight: bold; color: #F08A4B; padding: 10px 14px 6px; border-bottom: 1px solid #f5f5f5; }
.group-title.seasoning-title { color: #8e6b1f; }
.item { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid #f7f7f7; }
.item:last-child { border-bottom: none; }
.checkbox { width: 22px; height: 22px; border: 2px solid #F08A4B; border-radius: 6px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.checkbox.checked { background: #F08A4B; }
.tick { color: #fff; font-size: 14px; font-weight: bold; line-height: 1; }
.item-text { font-size: 15px; color: #333; flex: 1; }
.item-text.done { text-decoration: line-through; color: #bbb; }
.main-tag { font-size: 11px; color: #F08A4B; border: 1px solid #F08A4B; border-radius: 4px; padding: 1px 5px; flex-shrink: 0; }
.staple-tag { font-size: 11px; color: #8e6b1f; border: 1px solid #8e6b1f; border-radius: 4px; padding: 1px 5px; flex-shrink: 0; }

/* 补充调料 */
.seasoning-entry { margin: 16px; padding: 12px; text-align: center; color: #8e6b1f; background: #fdf3df; border: 1px dashed #e0c89a; border-radius: 10px; font-size: 14px; }
.seasoning-entry .plus { font-weight: bold; margin-right: 4px; }
.add-panel { margin: 0 16px; padding: 12px; background: #fff; border-radius: 10px; }
.add-row { display: flex; gap: 8px; }
.add-input { flex: 1; border: 1px solid #eee; border-radius: 8px; padding: 8px 10px; font-size: 14px; background: #fafafa; }
.add-send { background: #F08A4B; color: #fff; font-size: 13px; border-radius: 8px; padding: 0 16px; height: 38px; line-height: 38px; min-height: 0; margin: 0; }
.add-send::after { border: none; }
.lib-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; align-items: center; }
.lib-label { font-size: 12px; color: #aaa; width: 100%; }
.chip { font-size: 13px; color: #8e6b1f; background: #fdf3df; border: 1px solid #e0c89a; border-radius: 16px; padding: 5px 12px; }
.chip:active { background: #f3e2c0; }

/* 家庭共享面板 */
.share-card { margin: 12px 16px; padding: 14px; background: #fff; border-radius: 14px; box-shadow: 0 4px 14px rgba(181,121,63,.12); }
.share-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.share-title { font-size: 16px; font-weight: bold; color: #3a2f28; }
.share-code { font-size: 12px; color: #F08A4B; background: #fdf3df; border: 1px solid #e0c89a; border-radius: 10px; padding: 2px 10px; letter-spacing: 1px; }
.share-code:active { background: #f3e2c0; }
.share-join { display: flex; flex-direction: column; gap: 10px; }
.share-row { display: flex; gap: 8px; }
.share-input { flex: 1; border: 1px solid #eee; border-radius: 8px; padding: 8px 10px; font-size: 14px; background: #fafafa; }
.share-btn { background: #F08A4B; color: #fff; font-size: 14px; border-radius: 18px; padding: 0 18px; height: 38px; line-height: 38px; min-height: 0; margin: 0; }
.share-btn::after { border: none; }
.share-btn.primary { width: 100%; }
.share-btn.ghost { background: #f3ece6; color: #9C8E80; }
.share-empty { font-size: 13px; color: #9C8E80; text-align: center; padding: 8px 0; }
.share-list { margin-bottom: 10px; }
.share-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #f0ece8; }
.share-item-main { display: flex; align-items: baseline; gap: 6px; flex: 1; min-width: 0; }
.share-name { font-size: 15px; color: #3a2f28; }
.share-by { font-size: 11px; color: #9C8E80; }
.share-item-ctrl { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.share-qty { font-size: 13px; color: #F08A4B; font-weight: bold; }
.share-del { font-size: 14px; color: #c9b8a8; padding: 0 2px; }
.share-del:active { color: #e74c3c; }
.share-actions { display: flex; gap: 8px; margin-top: 4px; }
.share-actions .share-btn { flex: 1; }
.staple-hint { font-size: 12px; color: #b08a3a; background: #fdf3df; margin: 8px 16px 0; padding: 8px 12px; border-radius: 8px; line-height: 1.6; }
