<!-- 采购清单页 -->
<scroll-view scroll-y class="page">
  <view class="header">采购清单</view>

  <!-- 家庭共享（房间码，无登录） -->
  <view class="share-card">
    <view class="share-head">
      <text class="share-title">👨‍👩‍👧 家庭共享</text>
      <text wx:if="{{shareCode}}" class="share-code">房间码 {{shareCode}}</text>
    </view>

    <!-- 未加入：创建 / 输入码加入 -->
    <view wx:if="{{!shareCode}}" class="share-join">
      <button class="share-btn primary" bindtap="createRoom">创建共享房间</button>
      <view class="share-row">
        <input class="share-input" placeholder="输入房间码加入" value="{{shareJoinInput}}"
               bindinput="onShareJoinInput" />
        <button class="share-btn" bindtap="joinRoom">加入</button>
      </view>
    </view>

    <!-- 已加入：共享清单 -->
    <view wx:else>
      <view wx:if="{{shareItems.length === 0}}" class="share-empty">房间里还没有菜，把今天的清单加进来吧</view>
      <view wx:else class="share-list">
        <view class="share-item" wx:for="{{shareItems}}" wx:key="dish_name">
          <view class="share-item-main">
            <text class="share-name">{{item.dish_name}}</text>
            <text class="share-by">@{{item.added_by}}</text>
          </view>
          <view class="share-item-ctrl">
            <text class="share-qty">×{{item.quantity}}</text>
            <text class="share-del" catchtap="removeShareItem" data-name="{{item.dish_name}}">✕</text>
          </view>
        </view>
      </view>
      <view class="share-actions">
        <button class="share-btn primary" bindtap="pushMyList">把我的清单加入共享</button>
        <button class="share-btn ghost" bindtap="leaveRoom">退出房间</button>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{empty}}" class="empty">
    <image class="empty-img" src="../../images/cats/xiaoxia.jpg" mode="aspectFit" />
    <view class="empty-title">今天还没记录吃什么</view>
    <view class="empty-sub">先去「菜谱」选几道今天想吃的菜，会自动按菜品整理出食材清单</view>
    <button class="go-btn" bindtap="goRecord">去选菜</button>
    <view class="seasoning-entry" bindtap="toggleAdd">
      <text class="plus">＋</text> 补充常备调料
    </view>
  </view>

  <view wx:else>
    <view class="progress">
      <text>已买 {{bought}} / {{total}}</text>
      <view class="progress-btns">
        <button class="mini-btn" bindtap="clearChecked" wx:if="{{bought > 0}}">清空勾选</button>
        <button class="mini-btn staple" bindtap="clearStaple" wx:if="{{showStapleHint}}">常备标要买</button>
        <button class="mini-btn danger" bindtap="clearToday">清除当日</button>
      </view>
    </view>

    <view class="tip">按菜品列出所需食材，点击勾选已购买的（主材排在最前）</view>

    <view class="group" wx:for="{{groups}}" wx:key="dish">
      <view class="group-title {{item.isSeasoning ? 'seasoning-title' : ''}}">{{item.dish}}</view>
      <view class="item" wx:for="{{item.items}}" wx:for-item="mat" wx:key="text"
            bindtap="toggleItem" data-text="{{mat.text}}">
        <view class="checkbox {{mat.checked ? 'checked' : ''}}">
          <text wx:if="{{mat.checked}}" class="tick">✓</text>
        </view>
        <text class="item-text {{mat.checked ? 'done' : ''}}">{{mat.text}}</text>
        <text wx:if="{{mat.main}}" class="main-tag">主材</text>
        <text wx:if="{{mat.staple}}" class="staple-tag">常备</text>
      </view>
    </view>

    <!-- 补充调料入口 -->
    <view class="seasoning-entry" bindtap="toggleAdd">
      <text class="plus">＋</text> 补充常备调料
    </view>
    <view wx:if="{{showAdd}}" class="add-panel">
      <view class="add-row">
        <input class="add-input" placeholder="输入调料名，如 食用油" value="{{addInput}}"
               bindinput="onAddInput" confirm-type="send" bindconfirm="addSeasoning" />
        <button class="add-send" bindtap="addSeasoning">添加</button>
      </view>
      <view wx:if="{{seasoningLib.length > 0}}" class="lib-chips">
        <text class="lib-label">点选快速补充：</text>
        <view class="chip" wx:for="{{seasoningLib}}" wx:key="*this" bindtap="addSeasoning" data-name="{{item}}">{{item}}</view>
      </view>
    </view>

    <view wx:if="{{showStapleHint}}" class="staple-hint">勾选过的调料默认视为已购，如需购买点一下取消勾选</view>
  </view>
</scroll-view>
