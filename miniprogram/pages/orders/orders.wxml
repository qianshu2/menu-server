<!-- 饮食记录页 -->
<scroll-view scroll-y class="page">
  <view class="header">饮食记录</view>

  <!-- 饮食日历 -->
  <view class="cal-card">
    <view class="cal-bar">
      <text class="cal-nav" bindtap="prevMonth">‹</text>
      <text class="cal-title">{{calYear}}年{{calMonth}}月</text>
      <text class="cal-nav" bindtap="nextMonth">›</text>
    </view>
    <view class="cal-week">
      <text class="cal-wd {{index===0 || index===6 ? 'weekend' : ''}}" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="cal-grid">
      <view wx:for="{{calCells}}" wx:key="key"
            class="cal-cell {{item.empty ? 'is-empty' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.count > 0 ? 'has' : ''}} {{item.isWeekend ? 'weekend' : ''}} {{item.isSelected ? 'is-selected' : ''}}"
            data-day="{{item.empty ? '' : item.day}}" bindtap="onTapDay">
        <text wx:if="{{!item.empty}}" class="cal-day">{{item.day}}</text>
        <text wx:if="{{!item.empty}}" class="cal-lunar {{item.term ? 'term' : ''}}">{{item.lunar}}</text>
        <text wx:if="{{item.count > 0}}" class="cal-dot">{{item.count}}</text>
      </view>
    </view>
    <view class="cal-stats">
      <text class="cal-stat">🔥 连续 {{streak}} 天</text>
      <text class="cal-stat">📅 本月 {{monthCount}} 次</text>
    </view>
  </view>

  <!-- 当日记录详情：点击日历某天后展示 -->
  <view class="day-card" wx:if="{{selectedDate}}">
    <view class="day-head">
      <text class="day-title">{{selLabel}}</text>
      <text class="day-count">{{dayOrdersCount}} 条</text>
    </view>

    <view wx:if="{{dayOrdersCount === 0}}" class="day-empty">
      <image class="empty-img" src="../../images/cats/xiaoxia.jpg" mode="aspectFit" />
      <view class="empty-title">这一天还没有记录哦~</view>
      <view class="empty-sub">去「菜谱」挑几道，记下来吧</view>
    </view>

    <block wx:else>
      <view class="rec-card" wx:for="{{dayOrders}}" wx:key="index">
        <view class="rec-top">
          <text class="rec-name">{{item.dish_name}}</text>
          <text class="rec-qty">x{{item.quantity}}</text>
        </view>
        <view wx:if="{{item.note}}" class="rec-note">备忘：{{item.note}}</view>
        <view class="rec-time">{{item.created_at}}</view>
      </view>
      <button class="clear-day-btn" bindtap="clearSelected">清除当日记录</button>
    </block>

    <button class="shop-btn" bindtap="goShopping">生成今日采购清单 →</button>
  </view>
</scroll-view>
