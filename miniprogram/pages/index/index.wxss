.page { display: flex; flex-direction: column; height: 100vh; }
.header { background: #F08A4B; color: #fff; padding: 16px; text-align: center; font-size: 18px; font-weight: bold; flex-shrink: 0; }

/* 左右分栏 */
.main { display: flex; flex: 1; overflow: hidden; }
.sidebar { width: 88px; background: #F6EEE5; height: 100%; box-sizing: border-box; padding-bottom: 64px; }
.sidebar .cat-item { padding: 14px 4px; text-align: center; position: relative; }
.sidebar .cat-icon { width: 46px; height: 46px; margin: 0 auto 4px; display: block; border-radius: 12px; }
.sidebar .cat-name { font-size: 11px; color: #8a7a6b; line-height: 1.2; }
.sidebar .cat-item.active { background: #fff; }
.sidebar .cat-item.active .cat-name { color: #B5793F; font-weight: bold; }
.sidebar .cat-item.active::after { content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 4px; background: #F08A4B; }
.dish-area { flex: 1; background: #FBF4EE; height: 100%; box-sizing: border-box; padding-bottom: 64px; }
.section-title { padding: 12px 16px 4px; font-size: 14px; color: #9C8E80; }

/* 菜品卡片 —— 圆角 + 轻阴影，告别纯白平铺 */
.menu-item {
  margin: 10px 14px;
  padding: 12px;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 4px 14px rgba(181, 121, 63, 0.12);
  display: flex;
  align-items: center;
  gap: 12px;
}

/* 缩略图容器：统一圆角尺寸 */
.menu-thumb { width: 72px; height: 72px; }
.thumb-img { width: 100%; height: 100%; display: block; transition: opacity .25s ease; }

.menu-info { flex: 1; min-width: 0; }
.menu-name { font-size: 15px; font-weight: bold; margin-bottom: 4px; color: #3a2f28; }
.menu-meta { font-size: 13px; color: #F08A4B; }
.menu-btn { background: #F08A4B; color: #fff; font-size: 12px; padding: 0 12px; border-radius: 16px; height: 30px; line-height: 30px; min-height: 0; }
.menu-btn::after { border: none; }
.menu-btns { display: flex; align-items: center; gap: 5px; }
.recipe-btn { line-height: 24px; }
.recipe-btn { background: #fff; color: #F08A4B; border: 1px solid #F08A4B; }
.loading { text-align: center; padding: 30px; color: #aaa; }

/* 今日推荐 banner —— 渐变橙卡，营造「每天都有新推荐」的打开动机 */
.recommend {
  flex-shrink: 0;
  margin: 10px 14px 0;
  background: linear-gradient(135deg, #F08A4B, #F4A96B);
  border-radius: 16px;
  padding: 14px 14px 12px;
  box-shadow: 0 6px 16px rgba(181, 121, 63, 0.22);
  position: relative;
}
.rec-tag {
  position: absolute; top: -9px; left: 14px;
  background: #fff; color: #F08A4B; font-size: 11px; font-weight: bold;
  padding: 2px 10px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,.12);
}
.rec-close {
  position: absolute; top: -9px; right: 8px;
  width: 22px; height: 22px; line-height: 20px; text-align: center;
  background: #fff; color: #F08A4B; border-radius: 50%;
  font-size: 16px; font-weight: bold; box-shadow: 0 2px 6px rgba(0,0,0,.12);
  z-index: 1;
}
.rec-close:active { background: #f3ece6; }
.rec-body { display: flex; align-items: center; gap: 12px; margin-top: 6px; }
.rec-img { width: 56px; height: 56px; border-radius: 12px; background: rgba(255,255,255,.3); flex-shrink: 0; }
.rec-info { flex: 1; min-width: 0; color: #fff; }
.rec-name { font-size: 17px; font-weight: bold; }
.rec-cat { font-size: 12px; opacity: .92; margin-top: 3px; }
.rec-actions { display: flex; gap: 8px; margin-top: 10px; }
.rec-btn {
  flex: 1; background: #fff; color: #F08A4B; font-size: 13px; font-weight: bold;
  height: 32px; line-height: 32px; border-radius: 16px; padding: 0; margin: 0;
}
.rec-btn::after { border: none; }
.rec-ghost { background: rgba(255,255,255,.22); color: #fff; }
.rec-season { color: #fff; background: rgba(255,255,255,.28); border-radius: 8px; padding: 1px 6px; margin-left: 2px; font-size: 10px; }

/* 本季时令 —— 横向滑动的应季菜卡片 */
.season-card {
  flex-shrink: 0;
  margin: 12px 14px 0;
  background: #fff7ef;
  border: 1px solid #f3e2d2;
  border-radius: 16px;
  padding: 12px 12px 10px;
}
.season-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; }
.season-title { font-size: 15px; font-weight: bold; color: #c9702f; }
.season-veg { font-size: 11px; color: #b08a6a; flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.season-close {
  flex-shrink: 0; width: 22px; height: 22px; line-height: 20px; text-align: center;
  margin-left: 6px; background: #fff; color: #c9702f; border-radius: 50%;
  font-size: 17px; font-weight: bold; box-shadow: 0 2px 6px rgba(0,0,0,.12);
}
.season-close:active { background: #f3ece6; }
.season-scroll { display: flex; white-space: nowrap; }
.season-dish {
  display: inline-flex; flex-direction: column; align-items: center;
  width: 84px; margin-right: 10px; flex-shrink: 0;
}
.season-img { width: 72px; height: 72px; border-radius: 12px; background: #efe6dc; }
.season-name { font-size: 12px; color: #4a3a30; margin-top: 5px; max-width: 80px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.season-add {
  margin: 4px 0 0; background: #F08A4B; color: #fff; font-size: 11px;
  height: 24px; line-height: 24px; border-radius: 12px; padding: 0 10px;
}
.season-add::after { border: none; }

/* 今日记录 —— 浮在底部上层的可折叠栏，常驻可见，不占位 */
.cart {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 16px 16px 0 0;
  box-shadow: 0 -3px 14px rgba(0,0,0,.10);
  padding: 8px 16px 10px;
  box-sizing: border-box;
  z-index: 100;
}
.cart-bar { display: flex; justify-content: space-between; align-items: center; }
.cart-bar-info { display: flex; align-items: center; gap: 8px; }
.cart-title { font-size: 15px; font-weight: bold; color: #3a2f28; }
.cart-count-badge {
  background: #F08A4B; color: #fff; font-size: 12px;
  min-width: 18px; height: 18px; line-height: 18px; text-align: center;
  border-radius: 9px; padding: 0 5px;
}
.cart-arrow { font-size: 12px; color: #9C8E80; margin-left: 2px; }
.submit-btn-mini {
  background: #F08A4B; color: #fff; font-size: 14px; font-weight: bold;
  padding: 0 18px; border-radius: 18px; height: 34px; line-height: 34px;
  margin: 0;
}
.submit-btn-mini::after { border: none; }
.cart-detail { margin-top: 8px; max-height: 40vh; overflow-y: auto; }
.cart-title-old { font-size: 13px; color: #aaa; margin-bottom: 4px; }
.cart-empty { color: #ccc; font-size: 13px; padding: 4px 0; }

/* 今日记录项目 — 加减按钮 */
.cart-item { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px dashed #f0ece8; }
.cart-item-name { font-size: 14px; flex: 1; }
.cart-item-ctrl { display: flex; align-items: center; gap: 6px; }
.qty-btn { width: 28px; height: 28px; line-height: 28px; padding: 0; background: #f3ece6; color: #3a2f28; border-radius: 50%; font-size: 16px; text-align: center; border: none; }
.qty-btn:active { background: #e6dccf; }
.qty-num { font-size: 15px; font-weight: bold; min-width: 24px; text-align: center; }
.cart-item-sub { font-size: 14px; color: #F08A4B; font-weight: bold; min-width: 50px; text-align: right; }

/* 备注 */
.note-box { margin-top: 8px; }
.note-input { width: 100%; height: 36px; padding: 0 10px; background: #f8f3ee; border-radius: 6px; font-size: 13px; box-sizing: border-box; }

/* 记录汇总 & 保存 */
.cart-total { font-weight: bold; font-size: 16px; margin-top: 8px; padding-top: 8px; border-top: 1px solid #eee; }
.submit-btn { width: 100%; padding: 10px; background: #F08A4B; color: #fff; border-radius: 10px; font-size: 15px; font-weight: bold; margin-top: 8px; }
