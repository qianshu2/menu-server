<!-- 首页 — 私人菜谱 -->
<view class="page">
  <view class="header">今天吃什么</view>

  <!-- 今日推荐：按日期确定性选一道，给每天一个打开理由 -->
  <view wx:if="{{recommend}}" class="recommend">
    <view class="rec-close" catchtap="closeRecommend">×</view>
    <view class="rec-tag">小夏今天推荐</view>
    <view class="rec-body" bindtap="goToRecipe" data-name="{{recommend.name}}">
      <image class="rec-img" src="{{recImgError ? placeholder : apiBase + recommend.image}}" mode="aspectFill" binderror="onRecImgError" />
      <view class="rec-info">
        <view class="rec-name">{{recommend.name}}</view>
        <view class="rec-cat">{{recommend.category}} · 点我看做法</view>
      </view>
    </view>
    <view class="rec-actions">
      <button class="rec-btn" catchtap="addToCart" data-name="{{recommend.name}}">想吃</button>
      <button class="rec-btn rec-ghost" catchtap="reshuffle">换一道</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:else class="main">
    <!-- 左侧分类栏 -->
    <scroll-view scroll-y class="sidebar">
      <view wx:for="{{catList}}" wx:key="name"
            class="cat-item {{item.name === activeCat ? 'active' : ''}}"
            bindtap="switchCat" data-cat="{{item.name}}">
        <image class="cat-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="cat-name">{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 右侧菜品（所有分类连续排列，填满空白区域） -->
    <scroll-view scroll-y class="dish-area" scroll-into-view="{{scrollTarget}}" scroll-with-animation>
      <block wx:for="{{dishList}}" wx:key="name">
        <view wx:if="{{item.showTitle}}" id="cat{{item.catIndex}}" class="cat-anchor section-title">{{item.category}}</view>
        <view class="menu-item" bindtap="openDetail" data-name="{{item.name}}">
          <view class="img-box menu-thumb">
            <view wx:if="{{!item.imgLoaded && !item.imgError}}" class="skeleton"></view>
            <image wx:if="{{!item.imgError}}" class="thumb-img" src="{{apiBase}}{{item.image}}" mode="aspectFill"
                   bindload="onImgLoad" binderror="onImgError" data-idx="{{index}}"
                   style="opacity:{{item.imgLoaded ? 1 : 0}}" />
            <image wx:else class="thumb-img" src="{{placeholder}}" mode="aspectFit" />
          </view>
          <view class="menu-info">
            <view class="menu-name">{{item.name}}</view>
          </view>
          <view class="menu-btns">
            <button class="menu-btn" catchtap="addToCart" data-name="{{item.name}}">想吃</button>
            <button class="menu-btn recipe-btn" catchtap="goToRecipe" data-name="{{item.name}}">做法</button>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>

<view class="cart">
  <!-- 常驻浮层栏：随时可见已选数量，随时可记下来 -->
  <view class="cart-bar" bindtap="toggleCart">
    <view class="cart-bar-info">
      <text class="cart-title">今天想吃的</text>
      <text class="cart-count-badge">{{cartCount}}</text>
      <text class="cart-arrow">{{cartExpanded ? '收起' : '展开'}}</text>
    </view>
    <button class="submit-btn-mini" catchtap="submitOrder">记下来</button>
  </view>

  <!-- 展开后的明细 -->
  <view wx:if="{{cartExpanded}}" class="cart-detail">
    <view wx:if="{{cartCount === 0}}" class="cart-empty">还没想好吃什么</view>
    <block wx:else>
      <view class="cart-item" wx:for="{{cartList}}" wx:key="dish_name">
        <text class="cart-item-name">{{item.dish_name}}</text>
        <view class="cart-item-ctrl">
          <button class="qty-btn" catchtap="decreaseQty" data-name="{{item.dish_name}}">-</button>
          <text class="qty-num">{{item.quantity}}</text>
          <button class="qty-btn" catchtap="increaseQty" data-name="{{item.dish_name}}">+</button>
        </view>
      </view>
      <view class="note-box">
        <input class="note-input" placeholder="添加备忘..." value="{{note}}" bindinput="onNoteInput" />
      </view>
    </block>
  </view>

  <!-- 菜品详情弹层 -->
  <dish-detail
    visible="{{detailVisible}}"
    dish="{{detailDish}}"
    bind:close="closeDetail"
    bind:add="onDetailAdd"
    bind:recipe="onDetailRecipe"
  />
</view>
