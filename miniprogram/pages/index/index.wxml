<!-- 首页 — 私人菜谱 -->
<view class="page">
  <view class="header">今天吃什么</view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:else class="main">
    <!-- 左侧分类栏 -->
    <scroll-view scroll-y class="sidebar">
      <view wx:for="{{catList}}" wx:key="name"
            class="cat-item {{item.name === activeCat ? 'active' : ''}}"
            bindtap="switchCat" data-cat="{{item.name}}">
        <image class="cat-icon" src="{{item.icon}}" mode="aspectFit" />
        <view class="cat-name">{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 右侧菜品 -->
    <scroll-view scroll-y class="dish-area">
      <view class="section-title">{{activeCat}}</view>
      <view class="menu-item" wx:for="{{grouped[activeCat]}}" wx:for-item="item" wx:key="name">
        <image class="menu-img" src="{{apiBase}}{{item.image}}" mode="aspectFill" />
        <view class="menu-info">
          <view class="menu-name">{{item.name}}</view>
        </view>
        <view class="menu-btns">
          <button class="menu-btn" bindtap="addToCart" data-name="{{item.name}}">想吃</button>
          <button class="menu-btn recipe-btn" bindtap="goToRecipe" data-name="{{item.name}}">做法</button>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<view class="cart">
  <view class="cart-title">今天想吃的</view>
  <view wx:if="{{cartCount === 0}}" class="cart-empty">还没想好吃什么</view>
  <view wx:else>
    <view class="cart-item" wx:for="{{cartList}}" wx:key="dish_name">
      <text class="cart-item-name">{{item.dish_name}}</text>
      <view class="cart-item-ctrl">
        <button class="qty-btn" bindtap="decreaseQty" data-name="{{item.dish_name}}">-</button>
        <text class="qty-num">{{item.quantity}}</text>
        <button class="qty-btn" bindtap="increaseQty" data-name="{{item.dish_name}}">+</button>
      </view>
    </view>

    <!-- 备忘 -->
    <view class="note-box">
      <input class="note-input" placeholder="添加备忘..." value="{{note}}" bindinput="onNoteInput" />
    </view>

    <button class="submit-btn" bindtap="submitOrder">记下来</button>
  </view>
</view>
